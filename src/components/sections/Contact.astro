---
import { Image } from "astro:assets";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { contact } from "../../utils/data.ts";

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section id="contacto" class=`flex flex-col ${className}`>
  <div class={`w-100 py-10 md:py-16 bg-primary`}>
    <div
      class={`flex flex-col gap-10 lg:gap-12 midmd:flex-row-reverse mx-auto max-w-7xl w-full`}
    >
      <div
        class="max-w-md mx-auto midmd:max-w-none lg:mx-0 lg:pr-10 xl:pr-2 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto"
      >
        <div class="w-full h-80 sm:h-96 midmd:h-full relative">
          <Image
            src={contact.img}
            alt={contact.alt}
            width="1240"
            height="1385"
            class="w-auto left-1/2 -translate-x-1/2 absolute bottom-0 max-h-full rounded-3xl object-cover"
            loading={"lazy"}
          />
        </div>
      </div>

      <div
        class="max-w-md mx-auto w-11/12 flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col space-y-8"
      >
        <Title className="text-white">{contact.title} </Title>
        <Paragraph className="font-medium text:lg md:text-2xl text-white">
          {contact.description}
        </Paragraph>
        <ul
          class="text-base max-w-md space-y-5 font-medium text:lg md:text-2xl text-white"
        >
          <li class="flex items-center space-x-4">
            <div
              class="rounded-xl p-3 text-heading-1 w-max relative text-primary bg-white"
            >
              <slot set:html={contact.emailIcon} />
            </div>
            <a
              href=`mailto:${contact.email}?subject=Consulta&body=Hola%20CAPULI%20SCHOOL%0D%0ANecesito%20más%20informaci%C3%B3n%20sobre%3A%20https%3A%2F%2Fwww.capulischool.com"`
              class="hover:underline mr-2">{contact.email}</a
            >
          </li>
          <li class="flex items-center space-x-4">
            <div
              class="rounded-xl p-3 text-heading-1 w-max relative text-primary bg-white"
            >
              <slot set:html={contact.phoneIcon} />
            </div>
            <a href=`tel:${contact.phone1}` class="hover:underline mr-2"
              >{contact.phone1}</a
            >
            <a href=`tel:${contact.phone2}` class="hover:underline ml-2"
              >{contact.phone2}</a
            >
          </li>
          <li class="flex items-center space-x-4">
            <div
              class="rounded-xl p-3 text-heading-1 w-max relative text-primary bg-white"
            >
              <slot set:html={contact.scheduleIcon} />
            </div>
            <p class="">{contact.schedule}</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
  );
</section>
