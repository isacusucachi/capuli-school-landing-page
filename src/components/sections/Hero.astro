---
import { Image } from "astro:assets";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import ByNumber from "./ByNumber.astro";

import myHeroImage1 from "../../assets/images/hero3.jpg";
import ByResult from "./ByResult.astro";
import BtnLink from "../shared/BtnLink.astro";

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section class=`relative pt-32 lg:pt-36 ${className}`>
  <Container className={"flex flex-col lg:flex-row gap-10 lg:gap-12"}>
    <div
      class="relative flex flex-col items-center text-center lg:text-left lg:py-7 xl:py-8
        lg:items-start lg:max-w-none max-w-3xl mx-auto lg:mx-0 lg:flex-1 lg:w-1/2"
    >
      <h1
        class="text-3xl/tight sm:text-4xl/tight md:text-5xl/tight xl:text-6xl/tight
             font-bold text-heading-1 font-sans uppercase"
      >
        Aprende español y quechua con <br />
        <span class="text-primary">Capuli School</span>
      </h1>
      <Paragraph className="mt-8 ">
        Somos una escuela de idiomas virtual, especializada en la enseñanza del
        español y el quechua, dos idiomas muy importantes en Latinoamérica.
      </Paragraph>

      <div class="mt-16 w-full flex flex-col">
        <div class="lg:mx-auto mb-5">
          <BtnLink
            text="Comienza Ahora"
            href="#contacto"
            className="flex justify-center w-full sm:w-max"
            variant="primary"
          />
        </div>
        <div class="mx-auto">
          <ByResult />
        </div>
      </div>
    </div>

    <div
      class="flex flex-1 lg:w-1/2 lg:h-auto relative lg:max-w-none lg:mx-0 mx-auto max-w-3xl justify-center items-center"
    >
      <Image
        src={myHeroImage1}
        alt="Hero image"
        class="lg:absolute lg:w-full aspect-[16/9] rounded-3xl object-cover"
        loading={"eager"}
      />
    </div>
  </Container>

  <ByNumber />
  <!-- <ByResult /> -->
</section>
