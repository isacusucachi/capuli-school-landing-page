---
import { Image } from "astro:assets";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import GradiantText from "../shared/GradiantText.astro";
import { about } from "../../utils/data.ts";

export interface Props {
  className?: string;
}

const { className } = Astro.props;
---

<section id="nosotros" class=`flex flex-col ${className}`>
  <div class={`w-100 py-10 md:py-16 bg-primary`}>
    <div
      class={`flex flex-col gap-10 lg:gap-12 midmd:flex-row-reverse mx-auto max-w-7xl w-full`}
    >
      <div
        class="max-w-md mx-auto w-11/12 flex-1 flex midmd:w-7/12 lg:w-1/2 flex-col"
      >
        <Title className="text-white">{about.title} </Title>
        <Paragraph className="mt-8 font-medium text:lg md:text-2xl text-white">
          {about.description}
        </Paragraph>
      </div>
      <div
        class="max-w-md mx-auto midmd:max-w-none lg:mx-0 lg:pr-10 xl:pr-2 flex-1 flex w-11/12 midmd:w-5/12 lg:w-1/2 midmd:h-auto"
      >
        <div class="w-full h-80 sm:h-96 midmd:h-full relative">
          <Image
            src={about.img}
            alt="banner image"
            width="1240"
            height="1385"
            class="w-auto left-1/2 -translate-x-1/2 absolute bottom-0 max-h-full rounded-3xl object-cover"
            loading={"lazy"}
          />
        </div>
      </div>
    </div>
  </div>
  );
</section>
